{
  "name": "obsidrive",
  "version": "0.3.0",
  "description": "Obsidian Google Drive (appDataFolder) sync plugin",
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/build.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "release": "node scripts/release.mjs"
  },
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "builtin-modules": "^5.4.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true
}
